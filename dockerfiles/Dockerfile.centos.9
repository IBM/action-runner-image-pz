# FROM    quay.io/centos/centos:stream9
FROM    almalinux:9

ARG     RUNNERREPO="https://github.com/actions/runner" 
ARG     RUNNERPATCH
ARG     RUNNERMAINPATCH
ARG     SDK=8
ARG     ARCH

RUN     echo "tsflags=nodocs" >>/etc/dnf/dnf.conf

RUN     dnf update -y -q && \
        dnf install -y -q \
            wget git which langpacks-en glibc-all-langpacks sudo shadow-utils tar dotnet-sdk-${SDK}.0 \
            cmake make automake autoconf m4 gcc gcc-c++ libtool epel-release && \
        dnf clean all && \
        rm -rf /var/cache/dnf/*

RUN     echo "Using SDK - $(dotnet --version)"

ADD    ${RUNNERPATCH} /tmp/runner.patch

ADD     ${RUNNERMAINPATCH} /tmp/runner-main.patch

COPY    ../scripts/helpers/build-runner.sh /tmp/

# Latest release + release patch; falls back to main + main patch if that fails to patch or build
RUN     bash /tmp/build-runner.sh ${RUNNERREPO} /tmp/runner.patch /tmp/runner-main.patch

RUN     cd /tmp/runner/src && \
        ./dev.sh test && \
        rm -rf /root/.dotnet /root/.nuget

RUN     useradd -c 'Action Runner' -m -s /bin/bash runner && \
        usermod -L runner && \
        echo 'runner ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/runner && \
        chmod 440 /etc/sudoers.d/runner

RUN     mkdir -p /opt/runner-cache && \
        tar -xf /tmp/runner/_package/*.tar.gz -C /opt/runner-cache && \
        chown -R runner:runner /opt/runner-cache && \
        sudo -u runner /opt/runner-cache/config.sh --version

RUN     rm -rf /tmp/runner /tmp/runner.patch /tmp/runner-main.patch /tmp/build-runner.sh

USER    runner

EXPOSE  443

CMD     ["/bin/bash"]
